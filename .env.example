# Local development. Copy to .env — never commit the copy.

# Postgres, as started by ./scripts/db.sh up.
# Required by `pnpm ingest`, `pnpm web` and `pnpm migrate`.
# `pnpm analyze` prints to the terminal and needs no database.
DATABASE_URL=postgres://alertshield:alertshield@localhost:5433/alertshield

# Port for the report page (pnpm web)
PORT=3000

# Point the analyzer at the mock GitHub API instead of the real one.
# Unset (or set to https://api.github.com) to hit real GitHub.
GITHUB_API_BASE_URL=http://localhost:8787

# The mock server accepts any token. Real GitHub needs a PAT with `repo` /
# `actions:read` for private repos; public repos need no scopes.
GITHUB_TOKEN=mock-token-any-value-works

# Pin fixture generation to a fixed date for byte-identical output.
# Leave unset to anchor on today.
# FIXTURE_NOW=2026-08-01T00:00:00.000Z
